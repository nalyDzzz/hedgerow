{
  "name": "hedgerow",
  "productName": "Hedgerow",
  "version": "0.2.0",
  "description": "An open-source, cross-platform SQL client.",
  "license": "GPL-3.0-only",
  "author": "Hedgerow contributors",
  "homepage": "https://github.com/nalyDzzz/hedgerow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalyDzzz/hedgerow.git"
  },
  "bugs": {
    "url": "https://github.com/nalyDzzz/hedgerow/issues"
  },
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "test": "vitest run",
    "icons": "electron scripts/render-icons.cjs",
    "smoke": "node scripts/smoke-test.mjs",
    "package": "electron-vite build && electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.75.0",
    "playwright-core": "^1.65.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
